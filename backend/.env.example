# Backend environment variables
DATABASE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=change_me
DATABASE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Must be at least 32 characters for HS256
APP_JWT_SECRET=change_this_to_a_secure_secret_with_32_plus_chars
APP_JWT_EXPIRATION_MS=86400000

# Render / deployment settings
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend-domain.onrender.com
APP_SEED_STUDENTS=false
APP_SEED_RESET_STUDENTS=false
APP_SEED_SYNC_TIMETABLE=false
APP_SEED_REPLACE_ENROLLMENTS=false
